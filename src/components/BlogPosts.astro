---
const { items = [] } = Astro.props;

const posts = [
  {
    title: "Essential Security Tips for Small Business",
    category: "Security",
    excerpt: "Learn the essential security practices every small business should implement.",
  },
  {
    title: "Why Offsite Backup Matters",
    category: "Backup",
    excerpt: "Discover why reliable data backup is critical for business continuity.",
  },
  {
    title: "Streamlining Your Tech Stack",
    category: "Support",
    excerpt: "How to simplify your technology setup and reduce overhead costs.",
  },
];
---

<section class="py-24 lg:py-32 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/30 to-white"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-6">
        Resources
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold">Latest Blog Posts</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="group bg-white rounded-3xl border border-gray-100 overflow-hidden hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1 transition-all duration-500">
          <div class="h-48 bg-gradient-to-br from-primary/5 via-secondary/5 to-primary/10 flex items-center justify-center">
            <span class="text-6xl opacity-20 group-hover:opacity-30 transition-opacity duration-500">
              <svg class="w-16 h-16 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </span>
          </div>
          <div class="p-6 lg:p-8">
            <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-4">
              {post.category}
            </span>
            <h3 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors duration-300">
              {post.title}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
