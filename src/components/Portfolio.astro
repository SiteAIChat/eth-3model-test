---
const { items = [] } = Astro.props;

const projects = [
  {
    title: "Check out our work on ChallengeLaunchToolkit.com",
    url: "https://challengelaunchtoolkit.com",
    image: "https://essentialtechhelp.com/wp-content/uploads/2023/01/1.png",
  },
  {
    title: "Check out our work on DigitalWayfinders.com",
    url: "https://digitalwayfinders.com",
    image: "https://essentialtechhelp.com/wp-content/uploads/2023/01/4-1.png",
  },
];
---

<section id="portfolio" class="py-24 lg:py-32 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/30 to-white"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary/10 text-secondary text-sm font-semibold mb-6">
        Our Work
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold">Featured Projects</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      {projects.map((project) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="group block">
          <div class="relative rounded-3xl overflow-hidden bg-white border border-gray-100 hover:shadow-2xl hover:shadow-primary/10 hover:-translate-y-2 transition-all duration-500">
            <div class="aspect-video overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <div class="p-6 lg:p-8">
              <h2 class="text-xl font-bold group-hover:text-primary transition-colors duration-300">
                {project.title}
              </h2>
              <span class="inline-flex items-center mt-3 text-sm font-medium text-primary">
                View Project
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
