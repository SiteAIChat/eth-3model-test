---
const { items = [] } = Astro.props;
---

<section id="top" class="relative overflow-hidden">
  <div class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
  <div class="absolute -right-20 top-10 h-80 w-80 rounded-full bg-secondary/10 blur-3xl"></div>
  <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-12 lg:items-center lg:px-8 lg:py-20">
    <div class="lg:col-span-7">
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Don’t let complex technical hurdles keep you from success
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        Don’t let complex technical hurdles keep you from success Focus on Building Your Business and let us deal with the necessary but often time consuming tech related hassles that come with doing business in today&#8217;s fast paced world.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#checklist"
          class="rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-transform duration-300 hover:-translate-y-0.5"
        >
          GET STARTED
        </a>
        <a
          href="#checklist"
          class="rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold uppercase tracking-wide text-slate-700 transition-colors duration-300 hover:border-primary hover:text-primary"
        >
          Book A Call
        </a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl shadow-primary/10">
        <img
          src="https://essentialtechhelp.com/wp-content/uploads/2023/01/computer.png"
          alt=""
          class="mx-auto h-auto w-full max-w-sm"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
