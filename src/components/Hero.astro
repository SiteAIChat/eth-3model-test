---
const { items = [] } = Astro.props;
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-white to-purple-50"></div>
  <div class="absolute top-20 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary/5 rounded-full blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="space-y-8">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium">
          <span class="w-2 h-2 bg-primary rounded-full mr-2 animate-pulse"></span>
          Tech Support for Small Business
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">
          Don't let complex technical hurdles keep you from
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            success
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed max-w-xl">
          Focus on Building Your Business and let us deal with the necessary but often time consuming tech related hassles that come with doing business in today's fast paced world.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#services"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-semibold text-white bg-gradient-to-r from-primary to-secondary hover:shadow-xl hover:shadow-primary/25 hover:-translate-y-0.5 transition-all duration-300"
          >
            GET STARTED
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-semibold text-gray-700 bg-white border-2 border-gray-200 hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            Book A Call
          </a>
        </div>
      </div>

      <div class="relative lg:flex justify-center hidden">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-3xl rotate-6 scale-105"></div>
          <div class="relative bg-white rounded-3xl shadow-2xl p-8 space-y-6">
            <div class="flex items-center gap-4">
              <img
                src="https://essentialtechhelp.com/wp-content/uploads/2023/01/003-web-programming.png"
                alt="Web programming"
                class="w-16 h-16"
                loading="lazy"
              />
              <div>
                <p class="font-bold text-lg">Web Solutions</p>
                <p class="text-gray-500 text-sm">Custom built for your needs</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <img
                src="https://essentialtechhelp.com/wp-content/uploads/2023/01/002-video-conference.png"
                alt="Video conference"
                class="w-16 h-16"
                loading="lazy"
              />
              <div>
                <p class="font-bold text-lg">Remote Support</p>
                <p class="text-gray-500 text-sm">Available when you need it</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <img
                src="https://essentialtechhelp.com/wp-content/uploads/2023/01/004-rocket.png"
                alt="Rocket"
                class="w-16 h-16"
                loading="lazy"
              />
              <div>
                <p class="font-bold text-lg">Launch Ready</p>
                <p class="text-gray-500 text-sm">Get your business online fast</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
