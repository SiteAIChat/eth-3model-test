---
const { items = [] } = Astro.props;
---

<section id="security" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="space-y-6">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary/20 text-primary text-sm font-semibold">
          Protection
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          Cyber Security?
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            We've Got Your Back
          </span>
        </h2>
        <p class="text-lg text-gray-300 leading-relaxed">
          Antivirus and other cyber security software is important for small business owners to invest in because it protects their computers and network from malware and other cyber threats.
        </p>
        <p class="text-lg text-gray-300 leading-relaxed">
          This can help prevent data loss, network outages, and other problems that can harm a business's operations and reputation.
        </p>
      </div>

      <div class="flex justify-center">
        <div class="relative">
          <div class="absolute -inset-8 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-full blur-2xl"></div>
          <img
            src="https://essentialtechhelp.com/wp-content/uploads/2023/01/005-goals.png"
            alt="Cyber security"
            class="relative w-48 h-48 lg:w-64 lg:h-64 drop-shadow-2xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
