---
const { items = [] } = Astro.props;

const services = [
  {
    icon: "https://essentialtechhelp.com/wp-content/uploads/2023/01/005-goals.png",
    title: "SECURITY",
    description: "Protect your business with enterprise-grade security solutions tailored for small businesses.",
  },
  {
    icon: "https://essentialtechhelp.com/wp-content/uploads/2023/01/computer.png",
    title: "BACKUP",
    description: "Reliable offsite backup solutions to keep your critical data safe and recoverable.",
  },
  {
    icon: "https://essentialtechhelp.com/wp-content/uploads/2023/01/002-video-conference.png",
    title: "SUPPORT",
    description: "On-demand helpdesk support to keep your business running smoothly.",
  },
];
---

<section id="services" class="relative py-24 lg:py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/50 to-white"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary/10 text-secondary text-sm font-semibold mb-6">
        Our Services
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
        How Does Essential Tech Help?
      </h2>
      <h5 class="text-lg sm:text-xl text-gray-500 font-medium">
        Pay only for what You need When You need iT
      </h5>
      <p class="mt-6 text-gray-600 leading-relaxed max-w-2xl mx-auto">
        Lets face it as a small business owner you probably have better things to worry about than the tech that you need to run your business. Honestly you probably only care about two things: Is it Effectively being used and is it Efficiently being delivered. There is nothing worse in your mind than paying too much for tech when all you really need are the Essentials.
      </p>
      <p class="mt-4 text-gray-600 leading-relaxed max-w-2xl mx-auto">
        Thats why we think our Essential Tech Support Service is the perfect fit for small businesses just like yours. We cover the essentials you need at an affordable monthly rate and provide you with the support you need when you need it.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div class="group relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/5 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative bg-white rounded-3xl border border-gray-100 p-8 lg:p-10 hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1 transition-all duration-500">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center mb-6">
              <img src={service.icon} alt={service.title} class="w-12 h-12" loading="lazy" />
            </div>
            <h3 class="text-xl font-bold mb-3 tracking-wide">{service.title}</h3>
            <p class="text-gray-600 leading-relaxed">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
